# Server Configuration
PORT=5000
NODE_ENV=development

# Firebase Configuration
FIREBASE_PROJECT_ID=care-for-the-needy-patients
FIRESTORE_DATABASE_ID=(default)
# Local only: set this to the path of a newly generated service-account JSON.
# Do not commit the JSON or put private keys in this file.
GOOGLE_APPLICATION_CREDENTIALS=

# CTRI Configuration
CTRI_BASE_URL=https://ctri.nic.in/Clinicaltrials
CTRI_SEARCH_URL=https://ctri.nic.in/Clinicaltrials/advancesearchmain.php

# Sync Configuration
SYNC_CRON_SCHEDULE=0 2 * * *
BATCH_SIZE=50
REQUEST_DELAY_MS=2000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
